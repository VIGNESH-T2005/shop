# ---------- Required ----------
NODE_ENV=development
PORT=5000
# MongoDB Atlas connection string (must be a replica set - Atlas is - so transactions work)
MONGODB_URI=
# Frontend origin (no trailing slash). Used for CORS, cookies and Stripe redirect URLs.
CLIENT_URL=http://localhost:5173
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ---------- Stripe (test mode) ----------
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:5000/api/webhooks/stripe` (local) or the Stripe dashboard (production)
STRIPE_WEBHOOK_SECRET=

# ---------- Google sign-in (optional until you set it up) ----------
GOOGLE_CLIENT_ID=

# ---------- Image uploads via Cloudinary (optional) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Email (optional): none | smtp | resend ----------
EMAIL_PROVIDER=none
EMAIL_FROM=Shop-Zone <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# ---------- Store settings ----------
TAX_RATE=0.08

# ---------- Seed script ----------
ADMIN_EMAIL=admin@shop-zone.dev
ADMIN_PASSWORD=
